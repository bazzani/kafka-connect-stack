{
  "name": "gcp-pubsub-source-connector-googlecloud",
  "config": {
    "connector.class": "com.google.pubsub.kafka.source.CloudPubSubSourceConnector",
    "cps.project": "be-mygwtproject",
    "cps.subscription": "kafka-connect-topic-sub",
    "gcp.credentials.file.path": "/credentials/gcp-pubsub-credentials.json",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.confluent.connect.json.JsonSchemaConverter",
    "value.converter.schemas.enable": "false",
    "value.converter.schema.registry.url": "http://schema-registry:8081",
    "value.converter.auto.register.schemas": "false",
    "value.converter.use.latest.version": "true",
    "value.converter.latest.compatibility.strict": "false",
    "value.converter.json.fail.invalid.schema": "true",
    "kafka.topic": "pub-sub-topic",
    "transforms": "insertConnectorNameHeader,bytesToString,fromJson,valueToKey,extractKey",
    "transforms.insertConnectorNameHeader.type": "org.apache.kafka.connect.transforms.InsertHeader",
    "transforms.insertConnectorNameHeader.header": "connector.name",
    "transforms.insertConnectorNameHeader.value.literal": "gcp-pubsub-source-connector-googlecloud",
    "transforms.bytesToString.type": "com.github.jcustenborder.kafka.connect.transform.common.BytesToString$Value",
    "transforms.bytesToString.fields": "bytes",
    "transforms.fromJson.type": "com.github.jcustenborder.kafka.connect.json.FromJson$Value",
    "transforms.fromJson.json.schema.location": "Url",
    "transforms.fromJson.json.schema.url": "file:///schemas/gcp-pubsub-FromJson-schema.json",
    "transforms.valueToKey.type": "org.apache.kafka.connect.transforms.ValueToKey",
    "transforms.valueToKey.fields": "OrderNumber",
    "transforms.extractKey.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
    "transforms.extractKey.field": "OrderNumber",
    "errors.tolerance": "all",
    "errors.log.include.messages": "true",
    "errors.log.enable": "true"
  }
}
